# Google Gemini API Key (Get from https://aistudio.google.com for free)
GEMINI_API_KEY=

# Model Name (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ClickHouse Cloud Configuration (Optional: if blank, system runs in embedded high-speed columnar mode)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=True
